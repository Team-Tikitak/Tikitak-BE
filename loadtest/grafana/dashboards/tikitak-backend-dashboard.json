{
  "title": "Tikitak Backend (loadtest)",
  "uid": "tikitak-loadtest-backend",
  "tags": [
    "tikitak",
    "spring-boot",
    "loadtest"
  ],
  "timezone": "Asia/Seoul",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "ds",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "selected": true,
          "text": "Prometheus (loadtest)",
          "value": "tikitak-loadtest-prometheus"
        },
        "hide": 0
      },
      {
        "name": "job",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds}"
        },
        "query": {
          "query": "label_values(http_server_requests_seconds_count{application=\"tikitak\"}, job)",
          "refId": "job"
        },
        "definition": "label_values(http_server_requests_seconds_count{application=\"tikitak\"}, job)",
        "refresh": 1,
        "current": {
          "selected": true,
          "text": "tikitak-loadtest",
          "value": "tikitak-loadtest"
        },
        "hide": 0,
        "sort": 1,
        "options": [
          {
            "selected": true,
            "text": "tikitak-loadtest",
            "value": "tikitak-loadtest"
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Overview",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "RPS",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"$job\", uri!~\"/actuator.*\"}[$__rate_interval]))",
          "legendFormat": "",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "P95",
