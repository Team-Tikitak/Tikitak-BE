    {
      "id": 6,
      "type": "stat",
      "title": "DB Connections (active / max)",
      "description": "Hikari 풀 사용률. 90% 이상 지속되면 커넥션 풀 포화 (2026-09 부하테스트 병목 지점).",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "sum(hikaricp_connections_active{job=\"$job\"}) / sum(hikaricp_connections_max{job=\"$job\"})",
          "legendFormat": "",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
