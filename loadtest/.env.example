# 부하 측정용 앱 환경변수 템플릿 (#217, #215 공용)
# cp loadtest/.env.example loadtest/.env 로 복사해서 쓴다. loadtest/.env 는 커밋하지 않는다(.gitignore).
# 모든 외부 서비스 값은 가짜다. 측정 대상 API는 R2·Kakao·OAuth·Firebase를 호출하지 않고,
# 기동 시 필수 검증(@NotBlank, JwtSecretValidator, ImageOptimizationConfigValidator)만 통과하면 된다.
# 값에 공백·따옴표를 넣지 않는다(README의 Git Bash / PowerShell 로더가 그대로 읽는다).
# 값에 `$`도 넣지 않는다. docker compose도 이 파일을 읽어 `$`를 변수로 풀려고 한다.

# compose 프로젝트 이름과 호스트 포트 (docker compose -f loadtest/docker-compose.yml 이 이 파일에서 읽는다. 앱은 쓰지 않는다)
# 같은 PC의 다른 작업 폴더도 이 환경을 띄운다면, 폴더마다 아래 값을 겹치지 않게 바꾼다. 그대로 두면 #217 기본값이다.
# 이름: 컨테이너 <PROJECT>-{postgres,redis,prometheus,grafana}, 볼륨 <PROJECT>-{pgdata,prometheus,grafana}.
#   `down -v`는 이 프로젝트의 볼륨만 지운다. 이름이 같으면 다른 폴더의 시드 DB·Prometheus 데이터까지 지운다.
# 포트를 바꾸면 이 파일의 DB_URL(LOADTEST_PG_PORT), REDIS_PORT(LOADTEST_REDIS_PORT)도 같은 값으로 바꾼다.
# 앱 포트(SERVER_PORT, MANAGEMENT_SERVER_PORT)도 폴더마다 다르게 둔다. Prometheus는 MANAGEMENT_SERVER_PORT를 수집한다.
# k6를 직접 돌릴 때는 BASE_URL·MANAGEMENT_URL도 그 포트로 넘긴다(run-measure.sh는 이 파일의 두 포트로 자동으로 만든다).
# 예(#215 작업 폴더): LOADTEST_PROJECT=tikitak-loadtest-push, 55433/56380/59091/53001, SERVER_PORT=8082, MANAGEMENT_SERVER_PORT=8083
LOADTEST_PROJECT=tikitak-loadtest
LOADTEST_PG_PORT=55432
LOADTEST_REDIS_PORT=56379
LOADTEST_PROMETHEUS_PORT=59090
LOADTEST_GRAFANA_PORT=53000

SPRING_PROFILES_ACTIVE=dev

# 앱 API 포트. 앱 기본값(8080)과 같지만 작업 폴더마다 바꿀 수 있게 명시한다.
SERVER_PORT=8080

# DB: loadtest/docker-compose.yml 의 Postgres (호스트 포트 = LOADTEST_PG_PORT)
DB_URL=jdbc:postgresql://localhost:55432/tikitak
DB_USERNAME=tikitak
DB_PASSWORD=tikitak
# 기본값(10)과 같지만 측정 조건을 고정하려고 명시한다. 측정 도중 바꾸지 않는다.
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=10

# actuator를 API(8080)와 다른 포트로 분리한다. management 포트는 Tomcat 커넥터·스레드 풀이 따로라
# API 요청이 몰려도 Prometheus 수집과 Hikari 샘플러가 밀리지 않는다. Prometheus(compose)가 이 포트를 수집한다.
MANAGEMENT_SERVER_PORT=8081

# Redis: loadtest/docker-compose.yml 의 Redis (호스트 포트 = LOADTEST_REDIS_PORT)
REDIS_HOST=localhost
REDIS_PORT=56379
REDIS_PASSWORD=

# JWT: 32바이트 이상. k6 setup()이 같은 값으로 access token을 서명한다.
JWT_SECRET=loadtest-only-jwt-secret-do-not-use-elsewhere-0123456789
JWT_ACCESS_TOKEN_EXPIRES_IN=86400
JWT_REFRESH_TOKEN_EXPIRES_IN=604800
REFRESH_COOKIE_SECURE=false

# OAuth (가짜 값)
FRONTEND_REDIRECT_URI=http://localhost:3000/oauth/callback
GOOGLE_CLIENT_ID=loadtest-google-client-id
GOOGLE_CLIENT_SECRET=loadtest-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/oauth/google/callback
KAKAO_CLIENT_ID=loadtest-kakao-client-id
KAKAO_CLIENT_SECRET=loadtest-kakao-client-secret
KAKAO_REDIRECT_URI=http://localhost:8080/api/v1/auth/oauth/kakao/callback
APPLE_CLIENT_ID=loadtest-apple-client-id
APPLE_TEAM_ID=LOADTEST00
APPLE_KEY_ID=LOADTEST00
APPLE_PRIVATE_KEY=loadtest-apple-private-key
APPLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/oauth/apple/callback

# R2 (가짜 값. 조회 API는 R2를 호출하지 않는다)
R2_ACCOUNT_ID=loadtest
R2_REGION=auto
R2_ACCESS_KEY_ID=loadtest-access-key-id
R2_SECRET_ACCESS_KEY=loadtest-secret-access-key
R2_BUCKET_NAME=tikitak-loadtest
R2_ENDPOINT=https://loadtest-r2.invalid
# 이미지 최적화가 켜져 있으면(기본 true) 필수다
R2_PUBLIC_BASE_URL=https://loadtest-media.invalid

# Kakao Map (가짜 값, @NotBlank)
KAKAO_MAP_REST_API_KEY=loadtest-kakao-map-rest-api-key

# Firebase: 비워 두면 FirebaseConfig가 꺼진다
FIREBASE_CREDENTIALS_BASE64=
